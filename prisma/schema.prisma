// Boi Mohol (বই মহল) — schema
// BookRequest and Wishlist are still out of scope; see README for the
// phased roadmap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  READER
  ADMIN
}

enum FileType {
  FREE
  PAID
}

enum ShelfStatus {
  WANT
  READING
  FINISHED
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  WORN
}

enum ListingType {
  SELL
  EXCHANGE
  DONATE
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  COMPLETED
  REMOVED
}

enum ReportTargetType {
  LISTING
  MESSAGE
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  SCAM
  INAPPROPRIATE
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

enum RequestStatus {
  OPEN
  FULFILLED
  CLOSED
}

model User {
  id                   String             @id @default(cuid())
  name                 String
  username             String             @unique
  email                String             @unique
  // When the email was shown to belong to this person: at sign-up through
  // Google, or when they connect a Google account with the same address.
  // Password sign-ups are unverified (null).
  emailVerified        DateTime?
  // NULL for an account created through Google that hasn't set a password.
  passwordHash         String?
  // Google's account ID ("sub"). Google sign-ins are matched on this, never
  // on the email address.
  googleId             String?            @unique
  // True from a Google sign-up until the person picks a username; until
  // then they can't use the site (src/proxy.ts, src/lib/authz.ts). The
  // username meanwhile is a placeholder registration can never produce.
  needsUsername        Boolean            @default(false)
  bio                  String?
  location             String?
  role                 Role               @default(READER)
  yearlyGoal           Int? // books-per-year goal; no goal set is a valid state
  createdAt            DateTime           @default(now())
  // Set by an admin. A suspended user can't sign in, and an existing login
  // stops counting: see src/lib/account-status.ts.
  suspendedAt          DateTime?
  suspendedById        String?
  suspendedBy          User?              @relation("UserSuspensions", fields: [suspendedById], references: [id], onDelete: SetNull)
  // Set when the user changes their password. A login token carries the
  // value it saw at sign-in; once they differ the token no longer counts,
  // which signs out every other session (see src/lib/account-status.ts).
  passwordChangedAt    DateTime?
  suspensionsMade      User[]             @relation("UserSuspensions")
  reviews              Review[]
  shelfItems           ShelfItem[]
  readingActivity      ReadingActivity[]
  readingPositions     ReadingPosition[]
  listings             Listing[]          @relation("ListingSeller")
  listingsRemoved      Listing[]          @relation("ListingAdminRemovals")
  moderationTaken      ModerationAction[] @relation("ModerationByAdmin")
  moderationReceived   ModerationAction[] @relation("ModerationOfUser")
  conversationsStarted Conversation[]
  messagesSent         Message[]
  reportsFiled         Report[]
  blocksMade           Block[]            @relation("BlocksMade")
  blocksReceived       Block[]            @relation("BlocksReceived")
  wishlistItems        WishlistItem[]
  bookRequests         BookRequest[]
  requestResponses     RequestResponse[]
  bookFilesUploaded    BookFile[]
  bookSourcesAdded     BookSource[]       @relation("BookSourcesAdded")
}

model Category {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String // English name (for URLs/admin)
  nameBangla   String // Displayed name
  description  String?
  colorKey     String        @default("cloth") // maps to a palette key for generated covers/badges
  books        Book[]
  starterPicks StarterPick[]
  listings     Listing[]
  bookRequests BookRequest[]
}

model Book {
  id               String            @id @default(cuid())
  title            String
  titleBangla      String?
  author           String
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  description      String
  language         String            @default("bn")
  isPublicDomain   Boolean           @default(false)
  publishYear      Int?
  // Null when the author is living or the year isn't known. Under Bangladeshi
  // law a book can only be public domain once this is set and old enough --
  // see src/lib/public-domain.ts.
  authorDeathYear  Int?
  // Who wrote this text in its language, when the book is a translation or a
  // retelling (a Bangla translation of a Sanskrit or foreign work; an English
  // translation on Gutenberg). Shown on the book page.
  translator       String?
  // Other names the book can be found by in search but which are never shown,
  // e.g. a Bangla transliteration of an English title ("প্রাইড অ্যান্ড প্রেজুডিস").
  searchAliases    String[]          @default([])
  // Normalized title + Bangla title + author (+ translator and aliases) for
  // site search; always written through bookSearchText() in src/lib/search.ts.
  searchText       String            @default("")
  createdAt        DateTime          @default(now())
  reviews          Review[]
  shelfItems       ShelfItem[]
  starterPicks     StarterPick[]
  files            BookFile[]
  sources          BookSource[]
  readingPositions ReadingPosition[]
  wishlistItems    WishlistItem[]

  @@index([categoryId])
}

// Represents an uploaded readable file for a book (feature #4).
// rightsVerified must be true before a PAID file can be listed for sale,
// and should only be true for FREE files that are genuinely public domain
// or explicitly licensed — see README's copyright section.
// Where a free, legal copy hosted elsewhere can be read. Only these three
// sites are accepted (src/lib/book-sources.ts), and only for a book that
// passes the public-domain rule -- the same gate as an uploaded PDF.
enum SourceKind {
  WIKISOURCE
  GUTENBERG
  INTERNET_ARCHIVE
}

model BookSource {
  id          String     @id @default(cuid())
  bookId      String
  book        Book       @relation(fields: [bookId], references: [id], onDelete: Cascade)
  kind        SourceKind
  // Normalised by parseSourceUrl: https, no credentials or port.
  url         String
  // Why the copy is free to read, shown with the link.
  rightsBasis String
  // SetNull like BookFile.uploadedById, so deleting an admin's account isn't
  // blocked by the sources they added.
  addedById   String?
  addedBy     User?      @relation("BookSourcesAdded", fields: [addedById], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())

  @@unique([bookId, url])
  @@index([bookId])
}

model BookFile {
  id             String   @id @default(cuid())
  bookId         String
  book           Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  type           FileType @default(FREE)
  price          Float?
  // Superseded by publicId. Kept so historical rows are not lost, but nullable
  // because new records do not set it.
  fileUrl        String?
  // Cloudinary public_id. For raw uploads this INCLUDES the .pdf extension,
  // unlike image public_ids -- verified against the account.
  publicId       String
  fileSizeBytes  Int
  // Why this file is legally distributable, e.g. author died 60+ years ago.
  // Required for every new upload; the gate lives in src/actions/library.ts.
  rightsBasis    String
  sourceUrl      String?
  // Nullable with SetNull rather than a required FK: the privacy policy
  // promises account deletion, and a Restrict relation here would block it.
  // Provenance is kept for as long as the uploader has an account.
  uploadedById   String?
  uploadedBy     User?    @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  downloadCount  Int      @default(0)
  rightsVerified Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([bookId])
  @@index([uploadedById])
}

model Review {
  id            String   @id @default(cuid())
  bookId        String
  book          Book     @relation(fields: [bookId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  rating        Int // 1-5, required overall rating
  plotRating    Int? // 1-5, optional aspect rating
  writingRating Int? // 1-5, optional aspect rating
  pacingRating  Int? // 1-5, optional aspect rating
  text          String?
  createdAt     DateTime @default(now())

  @@unique([bookId, userId]) // one review per user per book
  @@index([bookId])
}

// The "AI suggestion" starting point for the MVP: editorial picks of
// "read this first" per category. A real ranking model can replace/augment
// this once there's usage data — see README's recommendation roadmap.
model StarterPick {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id])
  note       String // why this is a good first book in the category
  rank       Int      @default(1)

  @@unique([categoryId, bookId])
}

model ShelfItem {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  bookId     String
  book       Book        @relation(fields: [bookId], references: [id])
  status     ShelfStatus @default(WANT)
  finishedAt DateTime? // last time this was marked FINISHED; not cleared if status later changes
  updatedAt  DateTime    @updatedAt

  @@unique([userId, bookId])
}

// One row per user per calendar day they logged reading activity —
// backs the reading-streak calculation in src/lib/streak.ts.
model ReadingActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// Freeform secondhand-book listings — separate from the curated Book
// catalog above, so a listing doesn't need a matching Book/Category row.
model Listing {
  id               String           @id @default(cuid())
  sellerId         String
  seller           User             @relation("ListingSeller", fields: [sellerId], references: [id])
  title            String
  author           String
  categoryId       String?
  category         Category?        @relation(fields: [categoryId], references: [id])
  description      String?
  condition        ListingCondition
  listingType      ListingType
  price            Float? // only meaningful when listingType is SELL
  location         String
  status           ListingStatus    @default(AVAILABLE)
  // Normalized title + author + location; written via listingSearchText().
  searchText       String           @default("")
  // Set when an admin removes the listing (status REMOVED). The seller can
  // remove and restore their own listings, but never one an admin removed.
  removedByAdminAt DateTime?
  removedByAdminId String?
  removedByAdmin   User?            @relation("ListingAdminRemovals", fields: [removedByAdminId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  conversations Conversation[]
  photos        ListingPhoto[]

  @@index([sellerId])
  @@index([status])
}

// Cloudinary public_id rather than a full URL, so transforms (f_auto, q_auto,
// width) can be applied per context at render time — see src/lib/cloudinary.ts.
model ListingPhoto {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  publicId  String
  order     Int      @default(0)
  createdAt DateTime @default(now())

  @@index([listingId])
}

// One thread per (listing, interested buyer). The other participant is
// always the listing's seller, so it isn't duplicated here.
// Both links are nullable so a deleted account doesn't take the other
// person's history with it: deleting the seller's account deletes the
// listing (listingId -> NULL), deleting the buyer's sets buyerId to NULL.
model Conversation {
  id        String    @id @default(cuid())
  listingId String?
  listing   Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  buyerId   String?
  buyer     User?     @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([listingId, buyerId]) // re-contacting a listing reuses the thread
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  // NULL once the sender's account is deleted: the message stays with the
  // person who received it, shown as from a deleted user.
  senderId       String?
  sender         User?        @relation(fields: [senderId], references: [id], onDelete: SetNull)
  text           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId])
}

// targetId is deliberately not a foreign key: it points at a Listing, a
// Message, or a User depending on targetType, so the admin queue has to
// tolerate a target that has since been deleted.
model Report {
  id         String           @id @default(cuid())
  // NULL once the reporter's account is deleted; the report stays as evidence.
  reporterId String?
  reporter   User?            @relation(fields: [reporterId], references: [id], onDelete: SetNull)
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(OPEN)
  adminNote  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, createdAt]) // admin queue
  @@index([reporterId]) // rate-limit / duplicate checks
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

// "I want to read this" — points at a catalog Book, unlike BookRequest
// below which is freeform.
model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id])
  createdAt DateTime @default(now())

  @@unique([userId, bookId])
}

// "Does anyone have this?" — title/author are freeform because people
// often want books that aren't in the catalog at all.
model BookRequest {
  id          String            @id @default(cuid())
  requesterId String
  requester   User              @relation(fields: [requesterId], references: [id])
  title       String
  author      String
  categoryId  String?
  category    Category?         @relation(fields: [categoryId], references: [id])
  note        String? // edition, condition preferences, etc.
  location    String? // where they could collect from
  status      RequestStatus     @default(OPEN)
  // Normalized title + author; written via requestSearchText().
  searchText  String            @default("")
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  responses   RequestResponse[]

  @@index([requesterId])
  @@index([status])
}

model RequestResponse {
  id          String      @id @default(cuid())
  requestId   String
  request     BookRequest @relation(fields: [requestId], references: [id])
  responderId String
  responder   User        @relation(fields: [responderId], references: [id])
  message     String
  createdAt   DateTime    @default(now())

  @@unique([requestId, responderId]) // one response per person; editable, not spammable
  @@index([requestId])
}

// Every admin moderation step: who did it, when, to whose content, and a
// readable summary, so the record survives the content (reviews and
// requests are deleted outright) and even the account.
model ModerationAction {
  id           String               @id @default(cuid())
  adminId      String?
  admin        User?                @relation("ModerationByAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  action       ModerationActionType
  targetUserId String?
  targetUser   User?                @relation("ModerationOfUser", fields: [targetUserId], references: [id], onDelete: SetNull)
  // The listing, review or request acted on. Not a foreign key: the row may
  // be gone.
  targetId     String?
  summary      String
  // Set when the action was taken from the report queue.
  reportId     String?
  createdAt    DateTime             @default(now())

  @@index([targetUserId, createdAt])
  @@index([createdAt])
}

enum ModerationActionType {
  REMOVE_LISTING
  DELETE_REVIEW
  DELETE_REQUEST
  SUSPEND_USER
  UNSUSPEND_USER
  DELETE_USER
}

// Where a signed-in reader stopped in a book's in-site reader
// (/books/[id]/read). Readers who aren't signed in keep this in their own
// browser instead.
model ReadingPosition {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookId    String
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  // The page's path below the work's main page ("প্রথম খণ্ড/এক"); "" for
  // the main page.
  chapter   String
  // How far down that page, 0 to 1.
  progress  Float    @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, bookId])
  @@index([bookId])
}

// Wikisource pages fetched for the in-site reader, already cleaned, kept
// about a week so a page isn't fetched from Wikisource on every view
// (src/lib/wikisource/reader.ts). Rows older than a month are pruned.
model ReaderCache {
  key       String   @id
  data      Json
  fetchedAt DateTime @default(now())

  @@index([fetchedAt])
}
