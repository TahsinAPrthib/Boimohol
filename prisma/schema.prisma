// Boi Mohol (বই মহল) — schema
// BookRequest and Wishlist are still out of scope; see README for the
// phased roadmap.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  READER
  ADMIN
}

enum FileType {
  FREE
  PAID
}

enum ShelfStatus {
  WANT
  READING
  FINISHED
}

enum ListingCondition {
  NEW
  LIKE_NEW
  GOOD
  FAIR
  WORN
}

enum ListingType {
  SELL
  EXCHANGE
  DONATE
}

enum ListingStatus {
  AVAILABLE
  RESERVED
  COMPLETED
  REMOVED
}

enum ReportTargetType {
  LISTING
  MESSAGE
  USER
}

enum ReportReason {
  SPAM
  HARASSMENT
  SCAM
  INAPPROPRIATE
  COPYRIGHT
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED
}

model User {
  id                   String            @id @default(cuid())
  name                 String
  username             String            @unique
  email                String            @unique
  passwordHash         String
  bio                  String?
  location             String?
  role                 Role              @default(READER)
  yearlyGoal           Int? // books-per-year goal; no goal set is a valid state
  createdAt            DateTime          @default(now())
  reviews              Review[]
  shelfItems           ShelfItem[]
  readingActivity      ReadingActivity[]
  listings             Listing[]
  conversationsStarted Conversation[]
  messagesSent         Message[]
  reportsFiled         Report[]
  blocksMade           Block[]           @relation("BlocksMade")
  blocksReceived       Block[]           @relation("BlocksReceived")
}

model Category {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String // English name (for URLs/admin)
  nameBangla   String // Displayed name
  description  String?
  colorKey     String        @default("cloth") // maps to a palette key for generated covers/badges
  books        Book[]
  starterPicks StarterPick[]
  listings     Listing[]
}

model Book {
  id             String        @id @default(cuid())
  title          String
  titleBangla    String?
  author         String
  categoryId     String
  category       Category      @relation(fields: [categoryId], references: [id])
  description    String
  language       String        @default("bn")
  isPublicDomain Boolean       @default(false)
  publishYear    Int?
  createdAt      DateTime      @default(now())
  reviews        Review[]
  shelfItems     ShelfItem[]
  starterPicks   StarterPick[]
  files          BookFile[]

  @@index([categoryId])
}

// Represents an uploaded readable file for a book (feature #4).
// rightsVerified must be true before a PAID file can be listed for sale,
// and should only be true for FREE files that are genuinely public domain
// or explicitly licensed — see README's copyright section.
model BookFile {
  id             String   @id @default(cuid())
  bookId         String
  book           Book     @relation(fields: [bookId], references: [id])
  type           FileType @default(FREE)
  price          Float?
  fileUrl        String
  rightsVerified Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([bookId])
}

model Review {
  id            String   @id @default(cuid())
  bookId        String
  book          Book     @relation(fields: [bookId], references: [id])
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  rating        Int // 1-5, required overall rating
  plotRating    Int? // 1-5, optional aspect rating
  writingRating Int? // 1-5, optional aspect rating
  pacingRating  Int? // 1-5, optional aspect rating
  text          String?
  createdAt     DateTime @default(now())

  @@unique([bookId, userId]) // one review per user per book
  @@index([bookId])
}

// The "AI suggestion" starting point for the MVP: editorial picks of
// "read this first" per category. A real ranking model can replace/augment
// this once there's usage data — see README's recommendation roadmap.
model StarterPick {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  bookId     String
  book       Book     @relation(fields: [bookId], references: [id])
  note       String // why this is a good first book in the category
  rank       Int      @default(1)

  @@unique([categoryId, bookId])
}

model ShelfItem {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id])
  bookId     String
  book       Book        @relation(fields: [bookId], references: [id])
  status     ShelfStatus @default(WANT)
  finishedAt DateTime? // last time this was marked FINISHED; not cleared if status later changes
  updatedAt  DateTime    @updatedAt

  @@unique([userId, bookId])
}

// One row per user per calendar day they logged reading activity —
// backs the reading-streak calculation in src/lib/streak.ts.
model ReadingActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  date      DateTime @db.Date
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

// Freeform secondhand-book listings — separate from the curated Book
// catalog above, so a listing doesn't need a matching Book/Category row.
model Listing {
  id          String           @id @default(cuid())
  sellerId    String
  seller      User             @relation(fields: [sellerId], references: [id])
  title       String
  author      String
  categoryId  String?
  category    Category?        @relation(fields: [categoryId], references: [id])
  description String?
  condition   ListingCondition
  listingType ListingType
  price       Float? // only meaningful when listingType is SELL
  location    String
  status      ListingStatus    @default(AVAILABLE)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  conversations Conversation[]

  @@index([sellerId])
  @@index([status])
}

// One thread per (listing, interested buyer). The other participant is
// always the listing's seller, so it isn't duplicated here.
model Conversation {
  id        String    @id @default(cuid())
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id])
  buyerId   String
  buyer     User      @relation(fields: [buyerId], references: [id])
  createdAt DateTime  @default(now())
  messages  Message[]

  @@unique([listingId, buyerId]) // re-contacting a listing reuses the thread
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
  senderId       String
  sender         User         @relation(fields: [senderId], references: [id])
  text           String
  createdAt      DateTime     @default(now())
  readAt         DateTime?

  @@index([conversationId])
}

// targetId is deliberately not a foreign key: it points at a Listing, a
// Message, or a User depending on targetType, so the admin queue has to
// tolerate a target that has since been deleted.
model Report {
  id         String           @id @default(cuid())
  reporterId String
  reporter   User             @relation(fields: [reporterId], references: [id])
  targetType ReportTargetType
  targetId   String
  reason     ReportReason
  details    String?
  status     ReportStatus     @default(OPEN)
  adminNote  String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@index([status, createdAt]) // admin queue
  @@index([reporterId]) // rate-limit / duplicate checks
}

model Block {
  id        String   @id @default(cuid())
  blockerId String
  blocker   User     @relation("BlocksMade", fields: [blockerId], references: [id])
  blockedId String
  blocked   User     @relation("BlocksReceived", fields: [blockedId], references: [id])
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}
