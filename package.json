{
  "name": "boimohol",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -H localhost",
    "build": "prisma migrate deploy && next build",
    "build:noMigrate": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "tsx --test src/**/*.test.ts",
    "postinstall": "prisma generate",
    "prisma:migrate": "node scripts/prisma-guard.mjs --check-shadow && prisma migrate dev",
    "db:diff": "prisma migrate diff --from-schema-datasource prisma/schema.prisma --to-schema-datamodel prisma/schema.prisma --script",
    "prisma:studio": "prisma studio",
    "seed": "tsx prisma/seed.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "@resvg/resvg-js": "2.6.2",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "dom-serializer": "3.1.1",
    "domhandler": "6.0.1",
    "domutils": "4.0.2",
    "harfbuzzjs": "1.6.3",
    "htmlparser2": "12.0.0",
    "next": "16.4.3",
    "next-auth": "^4.24.15",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sanitize-html": "2.17.7",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.14.15",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.0",
    "autoprefixer": "^10.4.20",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.4.41",
    "prisma": "^5.19.1",
    "tailwindcss": "^3.4.10",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4"
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  }
}
