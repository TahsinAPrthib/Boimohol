# PostgreSQL connection string (pooled, used by the app at runtime)
# connect_timeout=15: Neon sleeps when idle and takes ~5s to wake, which is
# exactly Prisma's default timeout -- without this, the first request after a
# quiet spell can fail (and a login can fail).
# pool_timeout=20: how long a query waits for a pool connection. Its 10s default
# is shorter than connect_timeout, so it would cut a slow wake off first.
DATABASE_URL="postgresql://user:password@localhost:5432/boimohol?connect_timeout=15&pool_timeout=20"

# Unpooled connection, used only by `prisma migrate`/`db execute`. On a
# plain single Postgres instance this can be the same value as above; on
# Neon, point it at the non-pooled host (no "-pooler" in the hostname).
DIRECT_URL="postgresql://user:password@localhost:5432/boimohol?connect_timeout=15"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Cloudinary (listing photos and library PDFs) ---
# Without these, uploads fail at runtime; the rest of the app still works.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
# Server-side only. Signs uploads. Must NEVER use the NEXT_PUBLIC_ prefix.
CLOUDINARY_API_SECRET="your-api-secret"
# Safe to expose: used in the browser to build delivery URLs. Same value as
# CLOUDINARY_CLOUD_NAME; a cloud name is public in every image URL anyway.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
