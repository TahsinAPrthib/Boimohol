# PostgreSQL connection string (pooled, used by the app at runtime)
# connect_timeout=15: Neon sleeps when idle and takes ~5s to wake, which is
# exactly Prisma's default timeout -- without this, the first request after a
# quiet spell can fail (and a login can fail).
# pool_timeout=20: how long a query waits for a pool connection. Its 10s default
# is shorter than connect_timeout, so it would cut a slow wake off first.
DATABASE_URL="postgresql://user:password@localhost:5432/boimohol?connect_timeout=15&pool_timeout=20"

# Unpooled connection, used only by `prisma migrate`/`db execute`. On a
# plain single Postgres instance this can be the same value as above; on
# Neon, point it at the non-pooled host (no "-pooler" in the hostname).
DIRECT_URL="postgresql://user:password@localhost:5432/boimohol?connect_timeout=15"

# Optional: only `npm run prisma:migrate` (prisma migrate dev) uses it. Prisma
# WIPES this database every time, so it must be a throwaway: its name must
# contain "shadow" and it must be on another server than the two above, or
# scripts/prisma-guard.mjs refuses to run. Never dev's or production's URL.
# The usual way to write a migration needs none: `npm run db:diff` prints the
# SQL from the dev schema, which goes into a new prisma/migrations folder.
# SHADOW_DATABASE_URL="postgresql://postgres:postgres@localhost:5433/boimohol_shadow"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-me"
NEXTAUTH_URL="http://localhost:3000"

# --- Cloudinary (listing photos and library PDFs) ---
# Without these, uploads fail at runtime; the rest of the app still works.
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
# Server-side only. Signs uploads. Must NEVER use the NEXT_PUBLIC_ prefix.
CLOUDINARY_API_SECRET="your-api-secret"
# Safe to expose: used in the browser to build delivery URLs. Same value as
# CLOUDINARY_CLOUD_NAME; a cloud name is public in every image URL anyway.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"

# --- Google sign-in ---
# New accounts can only be created through Google, so without these no one
# can sign up (existing email/password accounts can still log in). Create an
# OAuth client (Web application) in Google Cloud Console with the authorised
# redirect URI <NEXTAUTH_URL>/api/auth/callback/google.
GOOGLE_CLIENT_ID=
# Server-side only. Must NEVER use the NEXT_PUBLIC_ prefix.
GOOGLE_CLIENT_SECRET=

# --- In-site reader (optional, development only) ---
# Points the Wikisource reader at a stand-in API instead of
# https://bn.wikisource.org/w/api.php, for testing hostile pages or an
# unreachable Wikisource. Ignored in production builds.
# WIKISOURCE_API_URL=http://127.0.0.1:8787/w/api.php

# --- Reader cache ---
# Vercel cron sends this as a bearer token to /api/cron/reader-cache (the
# daily cleanup of the Wikisource reader's cache). Set any long random value
# in the Vercel project; without it the daily cleanup is refused (the cache
# is still cleaned up after writes).
CRON_SECRET=
# Optional: the cache's size cap in megabytes (default 50).
# READER_CACHE_MAX_MB=50

# --- Gutenberg reader (optional) ---
# The texts database: a separate free Neon project holding Gutenberg books
# made into reader pages. Without it, Gutenberg books show only their link.
# Here, use a DEVELOPMENT BRANCH of that project -- never the production
# texts database, whose string goes only into Vercel (Production) and the
# GitHub secret used by the seed workflow.
# TEXTS_DATABASE_URL="postgresql://user:password@ep-example-pooler.region.aws.neon.tech/neondb?sslmode=require"
# Optional: the cap, in megabytes, on books stored on demand (default 500).
# The 1,000 books stored by the seed workflow don't count toward it.
# TEXTS_CACHE_MAX_MB=500
# Development only: fetch books from a stand-in instead of
# https://gutenberg.pglaf.org. Ignored in production builds.
# GUTENBERG_MIRROR_URL=http://127.0.0.1:8099
