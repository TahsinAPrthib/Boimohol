{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/prisma-guard.mjs\" --hook",
            "timeout": 10,
            "statusMessage": "Checking the command against scripts/prisma-guard.mjs"
          }
        ]
      }
    ]
  }
}
